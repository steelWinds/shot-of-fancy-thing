---
import { getRelativeLocaleUrl } from 'astro:i18n';
import Layout from '~/shared/layouts/Layout.astro';
import { useTranslations } from '~/shared/lib';
import Button from '~/shared/ui/Button.astro';
import IconArrow from '~/shared/ui/Icons/IconArrow.astro';
import LottieAnimation from '~/shared/ui/LottieAnimation.svelte';

const t = useTranslations('en');

const homeUrl = getRelativeLocaleUrl('en', '/');
---

<Layout
  title={t('seo.404.title')}
  description={t('seo.404.description')}
  noindex
  ogImage='/og/en/404.png'
>
  <section
    class='
      container-xl
      min-h-svh
      grid
      place-items-center
      py-5
      lg:py-10
    '
  >
    <article
      class='
        w-full
        overflow-hidden
        rounded-4xl
        lg:rounded-[45px]
        border
        border-bg-strong
        bg-bg-surface
        grid
        lg:grid-cols-[minmax(0,1.15fr)_minmax(360px,0.85fr)]
      '
    >
      <div
        class='
          p-7
          sm:p-10
          lg:p-15
          flex
          flex-col
          items-start
          justify-center
        '
      >
        <p
          class='
            text-m-h4
            lg:text-h4
            bg-accent-green
            rounded-[7px]
            px-2
          '
        >
          {t('page.404.label')}
        </p>

        <h1 class='text-m-h1 lg:text-h1 mt-5 max-w-160'>
          {t('page.404.title')}
        </h1>

        <p class='text-m-p-large lg:text-p-large mt-5 max-w-145'>
          {t('page.404.description')}
        </p>

        <Button
          as='a'
          color='dark'
          href={homeUrl}
          class='inline-flex items-center gap-4 mt-8 lg:mt-10'
        >
          <IconArrow color='light' class='w-8 h-8' aria-hidden='true' />
          {t('page.404.backHome')}
        </Button>
      </div>

      <div
        class='
          relative
          overflow-hidden
          bg-accent-green
          min-h-70
          sm:min-h-85
          lg:min-h-150
          border-t
          lg:border-t-0
          lg:border-l
          border-bg-strong
        '
        aria-hidden='true'
      >
        <span
          class='
            absolute
            top-1/2
            left-1/2
            -translate-x-1/2
            -translate-y-1/2
            text-[clamp(100px,36vw,390px)]
            leading-none
            font-medium
            text-bg-strong
          '
        >
          404
        </span>

        <div
          class='
            absolute
            right-4
            bottom-4
            w-28
            h-28
            sm:right-8
            sm:bottom-8
            sm:w-36
            sm:h-36
            lg:w-44
            lg:h-44
          '
        >
          <LottieAnimation
            name='black-smile-animation'
            loop
            autoplay
            client:only='svelte'
          />
        </div>
      </div>
    </article>
  </section>
</Layout>

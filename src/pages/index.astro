---
import HomePage from '~/routes/Home/HomePage.astro';
import heroAnimationUrl from '~/shared/assets/lottie/sft-hero-animation.lottie?url';
import Layout from '~/shared/layouts/Layout.astro';
import { useTranslations } from '~/shared/lib';

const t = useTranslations('ru');
---

<Layout
  title={t('seo.index.title')}
  description={t('seo.index.description')}
  ogImage='/og/ru/home.png'
>
  <Fragment slot='head'>
    <link
      rel='preload'
      href='/vendor/dotlottie-player.wasm'
      as='fetch'
      type='application/wasm'
      crossorigin='anonymous'
    />
    <link
      rel='preload'
      href={heroAnimationUrl}
      as='fetch'
      crossorigin='anonymous'
    />
  </Fragment>

  <HomePage />
</Layout>

---
import { SEO } from 'astro-seo';
import { Font } from 'astro:assets';
import { getAbsoluteLocaleUrl } from 'astro:i18n';
import '~/shared/assets/styles/tailwind.css';

interface LanguageAlternate {
  href: string
  hrefLang: string
}

export interface Props {
  title: string
  description: string
  image?: string
  type?: 'website' | 'article' | 'profile'
  ogLocaleAlternate?: string[]
  languageAlternates?: LanguageAlternate[]
  noindex?: boolean
  nofollow?: boolean
  schema?: Record<string, unknown>
}

const {
  title,
  description,
  image,
  type = 'website',
  ogLocaleAlternate,
  noindex = false,
  nofollow = false,
  schema,
} = Astro.props;

const languageAlternates = [
  {
    href: getAbsoluteLocaleUrl('en', Astro.url.pathname),
    hrefLang: 'en',
  },
  {
    href: getAbsoluteLocaleUrl('ru', Astro.url.pathname),
    hrefLang: 'ru',
  },
].filter(({ hrefLang }) => hrefLang !== Astro.currentLocale);
---

<!doctype html>

<html lang={Astro.currentLocale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="SFT" />
    <link rel="manifest" href="/site.webmanifest" />

    <Font cssVariable="--font-onest" preload />

    <SEO
      title={title}
      description={description}
      canonical={Astro.url}
      noindex={noindex}
      nofollow={nofollow}
      robotsExtras="max-image-preview:large"
      languageAlternates={languageAlternates}
      openGraph={image
        ? {
          basic: {
            title,
            type,
            image,
            url: Astro.url,
          },

          optional: {
            description,
            locale: Astro.currentLocale,
            localeAlternate: ogLocaleAlternate,
            siteName: 'ShotOfFancyThing',
          },

          image: {
            width: 1200,
            height: 630,
            type: 'image/png',
            alt: title,
          },
        }
        : undefined}
      twitter={{
        card: 'summary_large_image',
      }}
    />

    {
      schema && (<script type="application/ld+json" set:html={JSON.stringify(schema)} />)
    }

    <slot name="head" />
  </head>

  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

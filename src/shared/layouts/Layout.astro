---
import { SEO } from 'astro-seo';
import { Font } from 'astro:assets';
import { getAbsoluteLocaleUrl, pathHasLocale } from 'astro:i18n';
import { withBase } from 'ufo';
import '~/shared/assets/styles/preflight.css';
import '~/shared/assets/styles/tailwind.css';
import '~/shared/assets/styles/animations.css';

interface LanguageAlternate {
  href: string
  hrefLang: string
}

export interface Props {
  title: string
  description: string
  ogImage: string
  type?: 'website' | 'article' | 'profile'
  languageAlternates?: LanguageAlternate[]
  locale?: string
  noindex?: boolean
  nofollow?: boolean
  schema?: Record<string, unknown>
}

const {
  title,
  description,
  ogImage,
  type = 'website',
  noindex = false,
  nofollow = false,
  locale = Astro.currentLocale,
  schema,
} = Astro.props;

const ogImageURL = withBase(ogImage, Astro.site?.href ?? '');

const path = pathHasLocale(Astro.url.pathname)
  ? Astro.url.pathname.split('/').slice(2).join('/')
  : Astro.url.pathname.slice(1);

const languageAlternates = [
  {
    href: getAbsoluteLocaleUrl('en', path),
    hrefLang: 'en',
  },
  {
    href: getAbsoluteLocaleUrl('ru', path),
    hrefLang: 'ru',
  },
  {
    href: getAbsoluteLocaleUrl('ru', path),
    hrefLang: 'x-default',
  },
];
---

<!doctype html>

<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="SFT" />
    <link rel="manifest" href="/site.webmanifest" />

    <Font cssVariable="--font-onest" preload />

    <SEO
      title={title}
      description={description}
      canonical={Astro.url}
      noindex={noindex}
      nofollow={nofollow}
      robotsExtras="max-image-preview:large"
      languageAlternates={languageAlternates}
      openGraph={{
        basic: {
          title,
          type,
          image: ogImageURL,
          url: Astro.url,
        },

        optional: {
          description,
          locale,
          siteName: 'ShotOfFancyThing',
        },

        image: {
          width: 1200,
          height: 630,
          type: 'image/png',
          alt: title,
        },
      }}
      twitter={{
        card: 'summary_large_image',
      }}
    />

    {
      schema && (<script type="application/ld+json" set:html={JSON.stringify(schema)} />)
    }

    <slot name="head" />
  </head>

  <body>
    <main>
      <slot />
    </main>
  </body>
</html>

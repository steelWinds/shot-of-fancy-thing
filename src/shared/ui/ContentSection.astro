---
import type { HTMLAttributes } from 'astro/types';
import type { ComponentProps } from 'svelte';
import Badge from './Badge.astro';
import TextHighlight from './TextHighlight.svelte';

type HighlightedText = ComponentProps<typeof TextHighlight>['items'];

interface Props extends HTMLAttributes<'section'> {
  title: string
  subtitle?: HighlightedText
}

const { title, subtitle, class: className, ...attrs } = Astro.props;
---

<section
  class="container-xl mx-auto"
  class:list={[className]}
  {...attrs}
>
  <div class="flex flex-row flex-wrap gap-5 lg:gap-10">
    <h2>
      <Badge class="text-m-h2 lg:text-h2">
        { title }
      </Badge>
    </h2>
    {
      subtitle && (
        <p class="text-m-p lg:text-p max-w-140 text-start">
          <TextHighlight items={subtitle} client:visible />
        </p>
      )
    }
  </div>

  <slot />
</section>

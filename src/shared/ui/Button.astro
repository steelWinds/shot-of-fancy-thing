---
import type { Polymorphic } from 'astro/types';

type Tag = 'a' | 'button' | 'span';
type Color = 'dark' | 'glass' | 'green';

type Props<T extends Tag> = Polymorphic<{
  as: T
  color?: Color
}>;

const { color, as: Element = 'button', class: className, ...props } = Astro.props;
---

<Element
  class="button"
  class:list={[
    color && 'button--is-styled',
    `button--color-${color}`,
    className,
  ]}
  {...props}
>
  <slot />
</Element>

<style scoped>
.button {
  --button-font-size: var(--text-m-p-large);
  --button-line-heigth: var(--text-m-p-large--line-height);
  --button-font-weight: 500;
  --button-padding: 16px 28px;

  @media (--breakpoint-lg) {
    --button-padding: 20px 35px;
    --button-font-size: var(--text-p-large);
    --button-line-heigth: var(--text-p-large--line-height);
    --button-font-weight: var(--text-p-large--font-weight);
  }
}

.button--is-styled {
  display: inline-block;
  padding: var(--button-padding);
  border-radius: 14px;
  font-size: var(--button-font-size);
  font-weight: var(--button-font-weight);
  line-height: var(--button-line-heigth);
  background-color: var(--button-bg-color);
  color: var(--button-text-color);
  border: 1px solid var(--button-border-color, transparent);
}

.button--color-dark {
  --button-bg-color: var(--color-bg-strong);
  --button-text-color: var(--color-white);
}

.button--color-glass {
  --button-bg-color: transparent;
  --button-text-color: var(--color-white);
  --button-border-color: var(--color-bg-strong);
}

.button--color-green {
  --button-bg-color: var(--color-accent-green);
  --button-text-color: var(--color-bg-strong);
}
</style>

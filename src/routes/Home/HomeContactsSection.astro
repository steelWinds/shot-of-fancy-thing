---
import type { HTMLAttributes } from 'astro/types';
import type { CollectionEntry } from 'astro:content';
import ContactCard from '~/shared/ui/ContactCard.astro';

type Contact = CollectionEntry<'home'>['data']['contacts']['items'][number];

interface Props extends HTMLAttributes<'section'> {
  items: Contact[]
}

const { items = [], class: className, ...props } = Astro.props;
---

<div
  class="bg-bg-surface p-5 lg:py-15 max-lg:-mx-5 lg:px-25 lg:rounded-[45px]"
  class:list={[className]}
  {...props}
>
  <ul
    class="
    flex
    flex-row
    flex-nowrap
    overflow-auto
    overscroll-x-none
    scroll-smooth
    scrollbar-none
    snap-x
    snap-mandatory
    max-lg:-mx-5
    lg:overflow-visible
    lg:grid
    lg:grid-cols-2
    lg:grid-rows-2
    lg:gap-x-10
    lg:gap-y-7.5
    max-lg:pr-5
  "
  >
    {
      items.map(contact => (
        <li class="max-lg:min-w-75 snap-start max-lg:pl-5">
          <ContactCard
            title={contact.title}
            subtitle={contact.subtitle}
            href={contact.link}
            color={contact.color}
            target="_blank"
            rel="noopener noreferrer"
          />
        </li>
      ))
    }
  </ul>
</div>

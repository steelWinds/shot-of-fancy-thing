---
import type { HTMLAttributes } from 'astro/types';
import type { CollectionEntry } from 'astro:content';
import GithubProjectCard from '~/shared/ui/GithubProjectCard.astro';
import LottieAnimation from '~/shared/ui/LottieAnimation.svelte';

type Project = CollectionEntry<'home'>['data']['projects']['items'][number];

interface Props extends HTMLAttributes<'section'> {
  items: Project[]
}

const { items = [], class: className, ...props } = Astro.props;
---

<ul
  class='flex
    flex-row
    flex-nowrap
    overflow-auto
    overscroll-x-none
    scroll-smooth
    scrollbar-none
    snap-mandatory
    snap-x
    lg:overflow-visible
    lg:grid
    lg:grid-cols-2
    lg:grid-rows-2
    lg:gap-x-10
    lg:gap-y-11.25
    max-lg:pr-5'
  class:list={[className]}
  {...props}
>
  {
    items.map(project => (
      <li class='max-lg:min-w-75 snap-start max-lg:pl-5'>
        <GithubProjectCard
          class='h-full'
          title={project.title}
          subtitle={project.subtitle}
          href={project.link}
          color={project.color}
          target='_blank'
          rel='noopener noreferrer'
        >
          <div
            class='
              absolute
              right-6
              bottom-6
              lg:bottom-12
              h-16
              lg:h-28
              max-w-56
            '
            class:list={[project.lottieClass]}
            slot='after'
            aria-hidden='true'
          >
            <div class='ml-auto w-full h-full'>
              <LottieAnimation
                name={project.lottie}
                loop
                autoplay
                client:visible
              />
            </div>
          </div>
        </GithubProjectCard>
      </li>
    ))
  }
</ul>

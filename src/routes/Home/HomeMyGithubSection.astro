---
import type { HTMLAttributes } from 'astro/types';
import type { CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Button from '~/shared/ui/Button.astro';
import LottieAnimation from '~/shared/ui/LottieAnimation.svelte';

type GithubCardContent = CollectionEntry<'home'>['data']['githubCard'];

interface Props extends HTMLAttributes<'article'> {
  title: GithubCardContent['title']
  subtitle: GithubCardContent['subtitle']
  link: GithubCardContent['link']
}

const { title, subtitle, link, class: className } = Astro.props;
---

<article
  class="
    grid
    grid-cols-1
    md:grid-cols-2
    items-center
    w-full
    p-7
    lg:px-15
    lg:py-18
    bg-bg-surface
    rounded-[28px]
    lg:rounded-[45px]
    relative
    overflow-visible
  "
  class:list={[className]}
>
  <div class="flex flex-col gap-5 lg:gap-6.5 items-start max-w-125">
    <h3 class="text-m-h3 lg:text-h3">
      {title}
    </h3>

    <p class="text-m-p lg:text-p">
      {subtitle}
    </p>

    <Button
      as="a"
      href={link}
      target="_blank"
      rel="noopener noreferrer"
      class="
        inline-flex
        flex-row
        gap-2
        items-center
        motion-safe:active:text-accent-green
        lg:motion-safe:pointer-fine:hover:text-accent-green
        transition-colors
        duration-fast
        ease-smooth
      "
      color="dark"
    >
      GitHub <Icon name="lucide:github" />
    </Button>
  </div>

  <div
    class="
      absolute
      w-1/3
      aspect-square
      right-15
      max-md:hidden
    "
    aria-hidden="true"
  >
    <LottieAnimation
      name="space-stars-animation"
      loop
      autoplay
      client:only="svelte"
    />
  </div>
</article>

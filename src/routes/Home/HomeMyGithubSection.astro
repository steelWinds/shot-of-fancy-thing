---
import type { HTMLAttributes } from 'astro/types';
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import spaceStarsImage from '~/shared/assets/images/space_stars.svg';
import Button from '~/shared/ui/Button.astro';

type Props = HTMLAttributes<'article'>;

const { class: className } = Astro.props;
---

<article
  class="
    grid
    grid-cols-1
    md:grid-cols-2
    items-center
    w-full
    p-7
    lg:px-15
    lg:py-18
    bg-bg-surface
    rounded-[28px]
    lg:rounded-[45px]
    relative
  "
  class:list={[className]}
>
  <div class="flex flex-col gap-5 lg:gap-6.5 items-start max-w-125">
    <h4 class="text-m-h3 lg:text-h3">
      Visit my GitHub
    </h4>

    <p class="text-m-p lg:text-p">
      There you can find my contact information, as well as my current projects!
    </p>

    <Button
      as="a"
      href="https://github.com/steelWinds"
      class="
        inline-flex
        flex-row
        gap-2
        items-center
        hover:text-accent-green
        transition-colors
        duration-fast
        ease-smooth
      "
      color="dark"
    >
      GitHub <Icon name="lucide:github" />
    </Button>
  </div>

  <Image
    class="
      absolute
      w-1/3
      aspect-square
      right-15
      max-md:hidden
    "
    src={spaceStarsImage}
    alt=""
    aria-hidden
  />
</article>

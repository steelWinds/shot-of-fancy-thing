---
import type { HTMLAttributes } from 'astro/types';
import type { CollectionEntry } from 'astro:content';
import LottieAnimation from '~/shared/ui/LottieAnimation.svelte';
import PixelBlast from '~/shared/ui/PixelBlast.svelte';
import TextHighlight from '~/shared/ui/TextHighlight.svelte';

type HeroContent = CollectionEntry<'home'>['data']['hero'];

interface Props extends Omit<HTMLAttributes<'section'>, 'title'> {
  titleFlat: HeroContent['titleFlat']
  title: HeroContent['title']
  description: HeroContent['description']
}

const {
  title,
  titleFlat,
  description,
  class: className,
  ...attrs
} = Astro.props;
---

<section
  class="grid grid-cols-1 lg:grid-cols-2 container-xl mx-auto relative gap-2"
  class:list={[className]}
  {...attrs}
>
  <div
    class="absolute inset-0 w-full max-w-[1920px] mx-auto h-full z-0"
    aria-hidden="true"
  >
    <PixelBlast
      variant="diamond"
      color="#b9ff66"
      patternScale={8}
      pixelSize={10}
      edgeFade={0.25}
      liquid={true}
      liquidRadius={0.5}
      client:media="(prefers-reduced-motion: no-preference)"
    />
  </div>

  <div class="pointer-events-none relative z-10">
    <h1
      class="home-hero-section__title text-m-h1 lg:text-h1 text-black pointer-events-auto"
    >
      <span class="sr-only">
        {titleFlat}
      </span>

      <TextHighlight
        items={title ?? []}
        client:media="(prefers-reduced-motion: no-preference)"
        aria-hidden="true"
      />
    </h1>

    <p
      class="home-hero-section__description text-m-p-large lg:text-p-large mt-6 lg:mt-8 text-black grid gap-2.5 pointer-events-auto"
    >
      {description?.map(desc => <span>{desc}</span>)}
    </p>
  </div>

  <div
    class="aspect-square
      w-full
      max-w-105
      mx-auto
      lg:max-w-none
      lg:absolute
      lg:w-1/2
      lg:right-0
      lg:-top-15
      relative
      z-10
      pointer-events-none
      home-hero-section__lottie"
    aria-hidden="true"
  >
    <LottieAnimation
      name="sft-hero-animation"
      loop
      autoplay
      client:only="svelte"
    />
  </div>
</section>

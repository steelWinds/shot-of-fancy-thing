{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/en(?:/.*)?$",
      "dest": "/en/404/",
      "status": 404
    },
    {
      "src": "^/.*$",
      "dest": "/404.html",
      "status": 404
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/en/",
      "statusCode": 301,
      "has": [
        {
          "type": "header",
          "key": "Accept-Language",
          "value": {
            "re": "^en(?:-|,|;|$)"
          }
        }
      ]
    }
  ]
}

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "Accept-Language",
          "value": {
            "re": "^en(?:-|,|;|$)"
          }
        }
      ],
      "headers": {
        "Location": "/en"
      },
      "status": 307
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/en(?:/.*)?$",
      "dest": "/en/404",
      "status": 404
    },
    {
      "src": "^/.*$",
      "dest": "/404",
      "status": 404
    }
  ]
}

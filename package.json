{
  "name": "shotoffancything",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint:eslint-check": "eslint",
    "lint:eslint": "eslint --fix",
    "lint:stylelint": "stylelint \"src/**/*.{css,astro}\"",
    "lint:stylelint:fix": "stylelint \"src/**/*.{css,astro}\" --fix",
    "lint:fix": "npm run lint:eslint:fix && npm run lint:stylelint:fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.10",
    "astro": "^7.3.2"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@csstools/postcss-global-data": "4.0.0",
    "@dreamsicle.io/stylelint-config-tailwindcss": "1.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "postcss": "8.5.28",
    "postcss-html": "2.0.0",
    "postcss-preset-env": "11.5.2",
    "postcss-pxtorem": "6.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "17.15.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "^4.3.3"
  },
  "nano-staged": {
    "*": "eslint --fix",
    "*.{css,astro}": "stylelint --fix"
  }
}

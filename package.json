{
  "name": "sft",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt cleanup && nuxt dev --host --clear --open",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "start": "node --env-file .env .output/server/index.mjs",
    "lint:eslint": "eslint --fix",
    "lint:stylelint": "stylelint \"**/*.{css,vue}\" --fix",
    "fsd:lint": "steiger ./src",
    "fsd:analyze": "fsd-crawler",
    "nano-staged": "nano-staged",
    "test:run": "vitest run --passWithNoTests",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky || true",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@morev/vue-transitions": "3.0.5",
    "@nuxt/content": "3.13.0",
    "@nuxt/fonts": "0.14.0",
    "@nuxt/image": "2.0.0",
    "@nuxtjs/i18n": "10.3.0",
    "@nuxtjs/seo": "5.1.3",
    "@pinia/colada": "^1.2.1",
    "@pinia/colada-nuxt": "^1.0.0",
    "@pinia/colada-plugin-cache-persister": "^1.0.0",
    "@pinia/nuxt": "^0.11.3",
    "@takumi-rs/core": "^1.1.2",
    "better-sqlite3": "^12.9.0",
    "dayjs": "^1.11.20",
    "dayjs-nuxt": "^2.1.11",
    "nuxt": "^4.4.4",
    "pinia": "^3.0.4",
    "ufo": "^1.6.4",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^8.2.0",
    "@csstools/postcss-global-data": "^4.0.0",
    "@dreamsicle.io/stylelint-config-tailwindcss": "^1.2.2",
    "@feature-sliced/steiger-plugin": "^0.5.7",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/eslint": "1.15.2",
    "@nuxt/hints": "1.0.3",
    "@nuxt/test-utils": "4.0.3",
    "@pinia/colada-devtools": "^1.0.0",
    "@tailwindcss/vite": "^4.2.4",
    "@vitest/coverage-v8": "^4.1.5",
    "@vue/test-utils": "^2.4.10",
    "eslint": "^9.0.0 || ^10.0.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "fsd-crawler": "^1.0.11",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "nano-staged": "^1.0.2",
    "postcss-preset-env": "^11.2.1",
    "postcss-pxtorem": "^6.1.0",
    "steiger": "^0.5.11",
    "stylelint": "^17.11.0",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "unhead": "^3.1.0",
    "vitest": "^4.1.5",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@morev/vue-transitions",
      "@parcel/watcher",
      "better-sqlite3",
      "esbuild",
      "sharp",
      "unrs-resolver",
      "vue-demi"
    ]
  },
  "nano-staged": {
    "*": "eslint --fix",
    "*.{css,vue}": "stylelint --fix"
  }
}

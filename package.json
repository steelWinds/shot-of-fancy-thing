{
  "name": "shotoffancything",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",

    "lint:eslint-check": "eslint",
    "lint:eslint": "eslint --fix",
    "lint:stylelint": "stylelint \"src/**/*.{css,astro,svelte}\"",
    "lint:stylelint:fix": "stylelint \"src/**/*.{css,astro,svelte}\" --fix",
    "lint:fix": "npm run lint:eslint && npm run lint:stylelint:fix",

    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:chromium": "playwright test --project=chromium-desktop",
    "test:e2e:firefox": "playwright test --project=firefox-desktop",
    "test:e2e:webkit": "playwright test --project=webkit-desktop",

    "test:lighthouse": "lhci autorun",
    "test:lighthouse:open": "lhci open",

    "prepare": "husky"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@astrojs/vercel": "^11.0.10",
    "@iconify-json/lucide": "^1.2.134",
    "@lottiefiles/dotlottie-svelte": "^0.10.15",
    "astro": "^7.3.2",
    "astro-icon": "^1.2.0",
    "astro-og-canvas": "^0.13.1",
    "astro-seo": "^1.2.0",
    "cn": "^0.4.0",
    "rough-notation": "^0.5.1",
    "svelte": "^5.57.1",
    "svelte-rough-notation": "^0.2.0",
    "typescript": "^6.0.3",
    "ufo": "^1.6.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@axe-core/playwright": "^4.13.0",
    "@csstools/postcss-global-data": "4.0.0",
    "@dreamsicle.io/stylelint-config-tailwindcss": "1.2.2",
    "@faker-js/faker": "^10.6.0",
    "@fast-check/vitest": "^0.5.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/ui": "^5.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-svelte": "^3.23.1",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.2",
    "nano-staged": "^1.0.2",
    "postcss": "8.5.28",
    "postcss-html": "^2.0.0",
    "postcss-preset-env": "11.5.2",
    "postcss-pxtorem": "6.1.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "stylelint": "17.15.0",
    "stylelint-config-html": "2.0.0",
    "stylelint-config-standard": "40.0.0",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.3"
  },
  "nano-staged": {
    "*": "eslint --fix",
    "*.{css,astro,svelte}": "stylelint --fix"
  }
}
